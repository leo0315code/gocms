{
  "name": "gocms-admin-assets",
  "version": "1.0.0",
  "private": true,
  "description": "GoCMS 后台样式构建（Tailwind CSS）与 UI 审计脚本",
  "scripts": {
    "build": "tailwindcss -i ./web/assets/src/input.css -o ./web/admin/static/app.css --minify",
    "dev": "tailwindcss -i ./web/assets/src/input.css -o ./web/admin/static/app.css --watch",
    "audit": "node scripts/audit-admin-ui.js"
  },
  "devDependencies": {
    "puppeteer-core": "^23.11.1",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "alpinejs": "^3.17.5"
  }
}
