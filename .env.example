APP_ENV=development
APP_NAME=GoCMS
APP_PORT=8090
APP_URL=http://localhost:8090

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=123456
DB_NAME=gocms
DB_PARAMS=charset=utf8mb4&parseTime=true&loc=Local&collation=utf8mb4_unicode_ci

SESSION_NAME=gocms_session
SESSION_LIFETIME=86400

UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=10

THEME=default
PAGE_SIZE=10
TZ=Asia/Shanghai

ADMIN_USER=admin
ADMIN_PASS=Admin@123456
ADMIN_EMAIL=admin@example.com

# 后台入口路径的初始值，仅首次初始化生效；之后在后台「系统设置 → 安全与入口」修改
ADMIN_PATH=admin

# 是否信任反向代理传来的 X-Real-IP / X-Forwarded-For
#   0（默认）：只用 TCP 对端地址，最安全。直连部署必须保持 0。
#   1：前面挂了 Nginx 等代理时设为 1，否则日志与限流拿到的是代理 IP（127.0.0.1）。
# 注意：任何客户端都能伪造这两个头，务必确认前置代理会覆盖它们。
TRUST_PROXY=0
